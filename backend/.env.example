# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
SECRET_KEY=supersecret-resumely-jwt-token-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase PostgreSQL Configuration
# Retrieve these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# AI Provider Configuration (Optional - built-in smart AI fallback works out-of-the-box!)
# Provider: "gemini" | "openai" | "heuristic"
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null
